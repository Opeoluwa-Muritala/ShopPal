# Application
ENVIRONMENT=
DEBUG=
SECRET_KEY=
JWT_SECRET=
PORT=

# Database & Cache
DATABASE_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=

# Meta WhatsApp Cloud API webhook authentication
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# WHATSAPP_TOKEN is the preferred name; WHATSAPP_ACCESS_TOKEN remains accepted for compatibility.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved template used only when a retry has crossed Meta's 24-hour window.
WHATSAPP_REENGAGEMENT_TEMPLATE_NAME=
WHATSAPP_REENGAGEMENT_TEMPLATE_LANGUAGE=en_US
# Enable after migration 0004; pending jobs remain durable while disabled.
META_REPLY_WORKER_ENABLED=false
META_REPLY_WORKER_CONCURRENCY=4
META_REPLY_WORKER_POLL_SECONDS=1

# Private Vercel server credential. Never prefix this with NEXT_PUBLIC_.
FRONTEND_API_KEY=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Customer AI (Google Gemma)
GEMMA_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it
# Optional complete Google-compatible generateContent URL.
GEMMA_API_URL=
GEMMA_TIMEOUT_SECONDS=20
# Gemma 4: minimal disables extended thinking for faster shopping replies.
GEMMA_THINKING_LEVEL=minimal
# Optional OpenRouter fallback. Google Gemma is primary whenever GEMMA_API_KEY is set;
# OpenRouter is used only when the Google request fails or returns unusable output.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-3-27b-it

# WhatsApp voice transcription (Groq Whisper)
GROQ_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Payment Gateways
# Flutterwave v4 dynamic virtual accounts (server-side only)
FLW_CLIENT_ID=
FLW_CLIENT_SECRET=
FLW_ENV=sandbox
FLW_WEBHOOK_SECRET_HASH=
FLW_ENCRYPTION_KEY=
ORDER_EXPIRY_MINUTES=30

# Legacy v3 keys are used only by the isolated compatibility adapter.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_HASH=
FLUTTERWAVE_REDIRECT_URL=
FLUTTERWAVE_PLATFORM_FEE_PERCENT=0.02

# ngrok / Webhook Base URL
WEBHOOK_BASE_URL=

# Application
ENVIRONMENT=
DEBUG=
SECRET_KEY=
JWT_SECRET=
PORT=

# Database & Cache
DATABASE_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=

# Twilio / WhatsApp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# Meta WhatsApp Cloud API webhook authentication
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved template used only when a retry has crossed Meta's 24-hour window.
WHATSAPP_REENGAGEMENT_TEMPLATE_NAME=
WHATSAPP_REENGAGEMENT_TEMPLATE_LANGUAGE=en_US
# Enable after migration 0004; pending jobs remain durable while disabled.
META_REPLY_WORKER_ENABLED=false
META_REPLY_WORKER_CONCURRENCY=4
META_REPLY_WORKER_POLL_SECONDS=1

# Private Vercel server credential. Never prefix this with NEXT_PUBLIC_.
FRONTEND_API_KEY=

# Customer AI (Google Gemma)
GEMMA_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it
# Optional complete Google-compatible generateContent URL.
GEMMA_API_URL=
GEMMA_TIMEOUT_SECONDS=20
# Gemma 4: minimal disables extended thinking for faster shopping replies.
GEMMA_THINKING_LEVEL=minimal
# Optional OpenRouter fallback. Google Gemma is primary whenever GEMMA_API_KEY is set;
# OpenRouter is used only when the Google request fails or returns unusable output.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-3-27b-it

# WhatsApp voice transcription (Groq Whisper)
GROQ_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Paystack Payment Gateway
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=

# ngrok / Webhook Base URL
WEBHOOK_BASE_URL=

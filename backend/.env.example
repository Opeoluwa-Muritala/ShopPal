# Application
ENVIRONMENT=
DEBUG=
SECRET_KEY=
JWT_SECRET=
PORT=

# Database & Cache
DATABASE_URL=
# Optional standby. It must contain the same schema and data as DATABASE_URL.
DATABASE_URL_2=
# Keep enabled for payment recovery, expiry and privacy retention.
# Disabling this requires arranging equivalent external jobs.
DATABASE_BACKGROUND_JOBS_ENABLED=true
DATABASE_FAILOVER_COOLDOWN_SECONDS=300
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
KEY_ENCRYPTION_SECRET=
BUMPA_BASE_URL=https://api.getbumpa.com/api/commerce/v1
BUMPA_TIMEOUT_SECONDS=10
BUMPA_SYNC_INTERVAL_MINUTES=10
# Post-payment order sync credentials; never expose these to the frontend.
BUMPA_PUBLIC_KEY=
BUMPA_SECRET_KEY=
BUMPA_LOCATION_ID=
# Set this only for the one-time legacy transfer reconciliation, then remove it.
RUN_PAYMENT_REPAIR_REFERENCE=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=

# Meta WhatsApp Cloud API webhook authentication
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# WHATSAPP_TOKEN is the preferred name; WHATSAPP_ACCESS_TOKEN remains accepted for compatibility.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_BASE=https://graph.facebook.com/v25.0
WHATSAPP_PUBLIC_NUMBER=
# Approved template used only when a retry has crossed Meta's 24-hour window.
WHATSAPP_REENGAGEMENT_TEMPLATE_NAME=
WHATSAPP_REENGAGEMENT_TEMPLATE_LANGUAGE=en_US
WHATSAPP_TEMPLATE_OWNER_TRANSFER_ALERT=
WHATSAPP_TEMPLATE_TRANSFER_EXPIRY=
WHATSAPP_TEMPLATE_OWNER_TRANSFER_EXPIRY=
WHATSAPP_TEMPLATE_OWNER_PAID=
# Enable after migration 0004; pending jobs remain durable while disabled.
META_REPLY_WORKER_ENABLED=false
META_REPLY_WORKER_CONCURRENCY=4
META_REPLY_WORKER_POLL_SECONDS=1
# Empty queues back off to ten minutes; same-process webhook wakeups stay immediate.
# Restart recovery, cross-process jobs and retries can wait up to this interval.
META_REPLY_WORKER_IDLE_POLL_SECONDS=600

# Private Vercel server credential. Never prefix this with NEXT_PUBLIC_.
FRONTEND_API_KEY=
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# HTML transfer alerts with signed Confirm/Reject links. Use your existing public backend URL.
BASE_URL=https://your-backend.example
EMAIL_API_URL=https://emailope.vercel.app/
OWNER_ALERT_EMAIL=

# Customer AI (Google Gemma)
GEMMA_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it
# Optional complete Google-compatible generateContent URL.
GEMMA_API_URL=
GEMMA_TIMEOUT_SECONDS=20
# Gemma 4: minimal disables extended thinking for faster shopping replies.
# Thinking is selected automatically in code; there is no environment switch.
# Optional OpenRouter fallback. Google Gemma is primary whenever GEMMA_API_KEY is set;
# OpenRouter is used only when the Google request fails or returns unusable output.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-3-27b-it

# WhatsApp voice transcription (Groq Whisper)
GROQ_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Payment Gateways
# Flutterwave v4 dynamic virtual accounts (server-side only)
FLW_CLIENT_ID=
FLW_CLIENT_SECRET=
FLW_ENV=sandbox
FLW_WEBHOOK_SECRET_HASH=
FLW_ENCRYPTION_KEY=
ORDER_EXPIRY_MINUTES=30

# Legacy v3 keys are used only by the isolated compatibility adapter.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_HASH=
FLUTTERWAVE_REDIRECT_URL=
FLUTTERWAVE_PLATFORM_FEE_PERCENT=0.02
